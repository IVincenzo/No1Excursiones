{
  "name": "no1-excursiones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "payload": "payload",
    "payload:importmap": "payload generate:importmap",
    "payload:import-pages": "tsx --env-file=.env.local scripts/import-main-pages.ts",
    "payload:migrate-media": "tsx --env-file=.env.local scripts/migrate-payload-media.ts",
    "payload:validate": "tsx --env-file=.env.local scripts/validate-payload.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/payload-cloud": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "bootstrap": "5.3.3",
    "next": "16.3.3",
    "next-intl": "4.3.12",
    "payload": "3.88.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "sharp": "0.34.3",
    "stripe": "18.5.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
